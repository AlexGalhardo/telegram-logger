{
    "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/v0.23.3/schema/markdownlint-cli2-config-schema.json",
    "config": {
        "default": true,
        // Docs use long soft-wrapped lines on purpose; hard-wrapping prose adds churn without value.
        "MD013": false,
        // Nothing formats Markdown tables here, and emoji/unicode cells break "aligned" column checks.
        "MD060": false,
        // CLAUDE.md is a bare "@AGENTS.md" import and the PR template starts at "##" on purpose.
        "MD041": false,
        // README uses bold labels (e.g. **npm**) above install snippets; they are not section headings.
        "MD036": false
    },
    "globs": ["**/*.md"],
    // CHANGELOG.md is generated by scripts/changelog.ts during releases.
    "ignores": ["node_modules", "dist", "CHANGELOG.md"]
}
